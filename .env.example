# ===================================================
# POLYMARKET APIS
# ===================================================

# Polymarket API Configuration
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com

# API Keys (optional for premium access)
POLYMARKET_API_KEY=

# ===================================================
# THE GRAPH (SUBGRAPH DATA)
# ===================================================

# The Graph API Key (optional, 100k queries/month free)
# Get your API key at: https://thegraph.com/studio/
THEGRAPH_API_KEY=

# ===================================================
# POLYGON BLOCKCHAIN
# ===================================================

# PolygonScan API Key (for on-chain data)
# Get free key at: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=

# Polygon RPC URL (for Web3 access)
POLYGON_RPC_URL=https://polygon-rpc.com

# Alternative RPC providers:
# - Alchemy: https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# - Infura: https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
# - QuickNode: https://your-endpoint.matic.quiknode.pro/YOUR_API_KEY/

# ===================================================
# NEWS & EVENTS
# ===================================================

# NewsAPI Key (for news data)
# Get free key at: https://newsapi.org/ (100 requests/day free)
NEWSAPI_KEY=

# Twitter/X API Bearer Token (for social media events)
# Get at: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# ===================================================
# OTHER DATA SOURCES (OPTIONAL)
# ===================================================

# Bitquery GraphQL API (alternative for blockchain data)
BITQUERY_API_KEY=

# Ethereum Mainnet RPC (if needed for Ethereum contracts)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# ===================================================
# TRADING (OPTIONAL - FOR AUTOMATED TRADING)
# ===================================================

# Private key for trading (USE WITH EXTREME CAUTION)
# Never commit this to version control!
PRIVATE_KEY=

# ===================================================
# DETECTION THRESHOLDS
# ===================================================

# Risk score thresholds
ALERT_THRESHOLD_HIGH=0.8
ALERT_THRESHOLD_MEDIUM=0.6
ALERT_THRESHOLD_LOW=0.4

# ===================================================
# DATA COLLECTION SETTINGS
# ===================================================

# Data collection interval (seconds)
DATA_COLLECTION_INTERVAL=60

# Historical data lookback period (days)
LOOKBACK_PERIOD_DAYS=30

# ===================================================
# ML MODEL SETTINGS
# ===================================================

# Model retraining interval (days)
MODEL_RETRAIN_INTERVAL=7

# LSTM sequence length
LSTM_SEQUENCE_LENGTH=50
