# Polymarket API Configuration
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com

# API Keys (if needed for premium access)
POLYMARKET_API_KEY=your_api_key_here
BITQUERY_API_KEY=your_bitquery_key_here

# Ethereum RPC (for on-chain analysis)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
POLYGON_RPC_URL=https://polygon-rpc.com

# Private key for trading (optional, for automated trading)
PRIVATE_KEY=your_private_key_here

# Detection thresholds
ALERT_THRESHOLD_HIGH=0.8
ALERT_THRESHOLD_MEDIUM=0.6
ALERT_THRESHOLD_LOW=0.4

# Data collection
DATA_COLLECTION_INTERVAL=60  # seconds
LOOKBACK_PERIOD_DAYS=30

# ML Model settings
MODEL_RETRAIN_INTERVAL=7  # days
LSTM_SEQUENCE_LENGTH=50
